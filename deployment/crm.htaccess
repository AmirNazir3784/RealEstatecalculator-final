# RealtorOS CRM — Hostinger / LiteSpeed / Apache headers.
# The CRM is a static SPA backed by Supabase cloud. Its browser connections:
#   - https://cdn.jsdelivr.net            (supabase-js library script)
#   - https://yanasorwmaybnabfuepn.supabase.co  (REST/Auth/Storage + realtime wss)
# Hash-based routing is used, so no server-side SPA fallback is required.

<IfModule mod_rewrite.c>
  RewriteEngine On
  # http -> https
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://yanasorwmaybnabfuepn.supabase.co; connect-src 'self' https://yanasorwmaybnabfuepn.supabase.co wss://yanasorwmaybnabfuepn.supabase.co; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
  # Strict Transport Security — UNCOMMENT ONLY AFTER HTTPS IS VERIFIED
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Application-update safety: the entry page, the service worker and the
# runtime config must never be cached, so a new deployment takes effect on
# the next visit. Static assets are unversioned, so they get a short
# must-revalidate cache only (no immutable, no long TTLs).
<IfModule mod_headers.c>
  <FilesMatch "(^index\.html$|^sw\.js$|config\.js$|\.webmanifest$)">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|png|jpe?g|svg|webp|avif|woff2?)$">
    Header always set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>

# Never serve internal files even if accidentally uploaded.
<FilesMatch "(\.md$|\.example$|\.cjs$)">
  Require all denied
</FilesMatch>
