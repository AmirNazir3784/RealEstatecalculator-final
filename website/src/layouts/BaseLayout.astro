---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  ogImage?: string;
  twitterCard?: string;
  robots?: string;
  googleSiteVerification?: string;
  bodyClass?: string;
  currentNav?: 'crm' | 'resources' | 'about' | 'contact' | '';
  extraStyles?: string[];
  extraScripts?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogType,
  ogImage,
  twitterCard,
  robots,
  googleSiteVerification,
  bodyClass,
  currentNav = '',
  extraStyles = [],
  extraScripts = [],
  structuredData,
} = Astro.props;

const segments = Astro.url.pathname.replace(/^\/|\/$/g, '').split('/').filter(Boolean);
const base = segments.length === 0 ? '' : '../'.repeat(segments.length);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#102131" />
  <SEO
    title={title}
    description={description}
    canonical={canonical}
    ogType={ogType}
    ogImage={ogImage}
    twitterCard={twitterCard}
    robots={robots}
    googleSiteVerification={googleSiteVerification}
    structuredData={structuredData}
  />
  <link rel="preload" as="font" type="font/woff2" href={`${base}assets/fonts/inter-latin.woff2`} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={`${base}assets/fonts/source-serif-4-latin.woff2`} crossorigin />
  <link rel="stylesheet" href={`${base}assets/site.css`} />
  <link rel="stylesheet" href={`${base}assets/theme.css`} />
  {extraStyles.map((href) => (
    <link rel="stylesheet" href={href} />
  ))}
  <slot name="head" />
  <link rel="icon" href={`${base}assets/favicon.ico`} sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href={`${base}assets/favicon-32x32.png`} />
  <link rel="icon" type="image/png" sizes="16x16" href={`${base}assets/favicon-16x16.png`} />
  <link rel="apple-touch-icon" sizes="180x180" href={`${base}assets/apple-touch-icon.png`} />
</head>
<body class={bodyClass || undefined}>
  <Header base={base} currentNav={currentNav} />
  <slot />
  <Footer base={base} />
  <script is:inline src={`${base}assets/site-config.js`} defer></script>
  <script is:inline src={`${base}assets/site.js`} defer></script>
  {extraScripts.map((src) => (
    <script is:inline src={src} defer></script>
  ))}
</body>
</html>
