---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RealtorCRM | CRM for Real Estate Agents"
  description="Explore RealtorCRM: follow-up tracking, Contacts, Deals, Calendar and Reports for real estate agents. Free during early access — view features and signup availability."
  canonical="https://everyrealestatecalculator.com/real-estate-crm/"
  currentNav="crm"
  extraStyles={["realtorcrm.css"]}
>
<main id="main" class="realtoros-page">
  <section class="rc-hero" aria-labelledby="product-title">
    <div class="wrap rc-hero-grid">
      <div>
        <span class="eyebrow">REALTORCRM · BUILT FOR REAL ESTATE AGENTS</span>
        <h1 id="product-title">Keep every lead, deal, and follow-up <span class="rc-accent">in one place.</span></h1>
        <p class="rc-lede">Manage contacts, track deals, plan follow-ups, and stay organized — so nothing slips through the cracks.</p>
        <div class="rc-actions">
          <a class="btn btn-primary" href="#access" data-crm-link="signup" aria-describedby="hero-access-note">Get Started with RealtorCRM</a>
          <a class="btn btn-outline" href="#features">Explore Features</a>
        </div>
        <p class="product-caption" id="hero-access-note">Sign up securely in the RealtorCRM app.</p>
        <ul class="rc-trust">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.2" stroke-width="1.8"/><path d="M8.4 12.4l2.4 2.4 4.8-5.2"/></svg>All-in-one workspace</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.2" stroke-width="1.8"/><path d="M8.4 12.4l2.4 2.4 4.8-5.2"/></svg>Simple and easy to use</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.2" stroke-width="1.8"/><path d="M8.4 12.4l2.4 2.4 4.8-5.2"/></svg>Built for realtors</li>
        </ul>
      </div>
      <figure class="rc-media">
        <div class="rc-media-frame" role="img" aria-label="Placeholder for the RealtorCRM product demo">
          <span class="rc-play" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 5.8v12.4c0 .8.9 1.3 1.6.9l9.3-6.2c.6-.4.6-1.4 0-1.8L10.6 4.9c-.7-.4-1.6.1-1.6.9z"/></svg></span>
          <strong class="rc-media-title">RealtorCRM Product Demo</strong>
          <p class="rc-media-sub">Add your product video or screenshots here</p>
        </div>
      </figure>
    </div>
  </section>

  <section class="section rc-features" id="features" aria-labelledby="features-title">
    <div class="wrap">
      <span class="eyebrow">EVERYTHING YOU NEED</span>
      <h2 id="features-title">The essential tools to run your real estate business.</h2>
      <div class="rc-cards">
        <article class="rc-card">
          <span class="rc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.4"/><path d="M3.6 19.2c.7-3 2.8-4.6 5.4-4.6s4.7 1.6 5.4 4.6"/><path d="M15.5 5.4a3.4 3.4 0 0 1 0 5.9M18.3 14.9c1.2.8 2 2 2.4 3.7"/></svg></span>
          <h3>Contacts</h3>
          <p>Keep your clients and leads organized with their details and history.</p>
        </article>
        <article class="rc-card">
          <span class="rc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7.8" width="18" height="12.2" rx="2"/><path d="M9 7.8V6a3 3 0 0 1 6 0v1.8M3 12.8h18"/></svg></span>
          <h3>Deals</h3>
          <p>Track opportunities, monitor progress, and manage your pipeline.</p>
        </article>
        <article class="rc-card">
          <span class="rc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.2" y="5" width="17.6" height="15.8" rx="2"/><path d="M8 3v3.6M16 3v3.6M3.2 10h17.6"/><path d="M9.3 15.6l2 2 3.6-3.8"/></svg></span>
          <h3>Follow-ups</h3>
          <p>Plan your next actions and keep conversations moving.</p>
        </article>
        <article class="rc-card">
          <span class="rc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4v15.4h16"/><path d="M8.2 16v-4.6M12.2 16V8.4M16.2 16v-6.4"/></svg></span>
          <h3>Reports</h3>
          <p>Review your activity and understand what needs attention.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section rc-how" id="how-it-works" aria-labelledby="workflow-title">
    <div class="wrap">
      <div class="rc-how-box">
        <div>
          <span class="eyebrow">HOW IT WORKS</span>
          <h2 id="workflow-title">A simple workflow that keeps you ahead.</h2>
        </div>
        <ol class="rc-steps">
          <li class="rc-step">
            <span class="rc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="8" r="3.4"/><path d="M4.2 19.4c.7-3.1 2.9-4.8 5.8-4.8 1.7 0 3.2.6 4.3 1.8"/><path d="M18.6 8.2v6M15.6 11.2h6"/></svg></span>
            <h3>Add a Contact</h3>
            <p>Save leads and clients in one organized workspace.</p>
          </li>
          <span class="rc-arrow" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13.5 6l6 6-6 6"/></svg></span>
          <li class="rc-step">
            <span class="rc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.2" y="5" width="17.6" height="15.8" rx="2"/><path d="M8 3v3.6M16 3v3.6M3.2 10h17.6"/><circle cx="12" cy="15" r="1.3" fill="currentColor" stroke="none"/></svg></span>
            <h3>Plan a Follow-up</h3>
            <p>Set your next action and stay on track.</p>
          </li>
          <span class="rc-arrow" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15M13.5 6l6 6-6 6"/></svg></span>
          <li class="rc-step">
            <span class="rc-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 3.2h7.2L18 7v13.8H7z"/><path d="M14 3.2V7h4"/><path d="M9.9 14.3l1.9 1.9 3.3-3.5"/></svg></span>
            <h3>Move the Deal Forward</h3>
            <p>Keep opportunities progressing with clear next steps.</p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section rc-mobile" aria-labelledby="mobile-title">
    <div class="wrap rc-split">
      <div>
        <span class="eyebrow">MOBILE &amp; PWA EXPERIENCE</span>
        <h2 id="mobile-title">Your workspace, wherever your day takes you.</h2>
        <p>Access your contacts, follow-ups, and deals from your phone or desktop.</p>
        <p class="muted">On supported devices and browsers, RealtorCRM can also be installed as a progressive web app (PWA): add it to your home screen and open it like an app, with no app-store download.</p>
        <p class="product-caption">Installation availability depends on your device and browser.</p>
        <a class="rc-text-link" href="#access">View access availability <span aria-hidden="true">→</span></a>
      </div>
      <figure class="rc-phone">
        <div class="rc-phone-frame" role="img" aria-label="Placeholder for a RealtorCRM mobile screenshot">
          <strong class="rc-media-title">RealtorCRM Mobile Preview</strong>
          <p class="rc-media-sub">Add your real mobile screenshot here</p>
        </div>
        <figcaption>Reserved for the real mobile experience.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section rc-cta-section" id="access" aria-labelledby="access-title">
    <div class="wrap">
      <div class="rc-cta">
        <h2 id="access-title">Your next opportunity starts with better follow-up.</h2>
        <p>Stay organized, respond with clarity, and keep your real estate work moving. RealtorCRM is free during early access — organize your contacts, deals, tasks, and follow-ups in one place.</p>
        <div class="rc-actions rc-cta-actions">
          <a class="btn rc-btn-light" href="#access" data-crm-link="signup">Get Started with RealtorCRM</a>
          <a class="btn rc-btn-ghost" href="#features">Explore All Features</a>
        </div>
        <p class="rc-access-note">Sign up or log in in the RealtorCRM app — your account and workspace are created there. This website never asks for your password.</p>
      </div>
    </div>
  </section>
</main>
</BaseLayout>
