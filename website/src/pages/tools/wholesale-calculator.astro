</div></fieldset>
<fieldset class="form-group"><legend>Your deal</legend><div class="form-grid">
<div class="form-field"><label for="wholesale-fee">Your wholesale fee</label><span class="input-unit"><span class="unit-affix">$</span><input class="field" id="wholesale-fee" type="number" min="0" step="500" value="10000"></span><small class="field-helper">Your assignment or resale margin.</small></div>
<div class="form-field"><label for="asking-price">Seller's asking price</label><span class="input-unit"><span class="unit-affix">$</span><input class="field" id="asking-price" type="number" min="0" step="1000" value="125000"></span><small class="field-helper">Checked against your maximum below.</small></div>
